<?xml version="1.0" encoding="utf-8"?>
<!--
  Defense in depth: even if allowBackup is flipped back on, exclude all sensitive
  child/health data. Children's data must never land in Google cloud backup.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
